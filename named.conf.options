acl bogon-nets {
    !127.0.0.1;
    !192.168.0.0/16;
    0.0.0.0/8;
    10.0.0.0/8;
    100.64.0.0/10;
    127.0.0.0/8;
    !169.254.1.2;
    169.254.0.0/16;
    172.16.0.0/12;
    192.0.0.0/24;
    192.0.2.0/24;
    192.88.99.0/24;
    198.18.0.0/15;
    198.51.100.0/24;
    203.0.113.0/24;
    224.0.0.0/3;
};

options {
    directory "/var/cache/bind";
    recursion no;
    allow-recursion { none; };
    allow-query { 192.168.21.0/24; 127.0.0.1; 169.254.1.2; };
    allow-transfer { 192.168.21.0/24; 127.0.0.1; 169.254.1.2; };
    listen-on-v6 { none; };
    blackhole { bogon-nets; };
};
